# Copie para .env (NÃO versione o .env) e carregue com:  set -a; source .env; set +a

# Opcional: o padrão é o servidor de homologação do OpenAPI.
API_BASE_URL=https://api-homolog.bancodigital.exemplo/v1

# Bearer tokens dos dois usuários de teste (sem o prefixo "Bearer ").
TOKEN_USUARIO_A=
TOKEN_USUARIO_B=

# UUID da conta de cada usuário.
CONTA_ID_A=
CONTA_ID_B=

# Chave PIX da conta B: destino das transferências feitas por A (obrigatória).
CHAVE_PIX_B=
# Chave PIX da conta A: opcional; liga o teste de isolamento da Idempotency-Key entre usuários.
CHAVE_PIX_A=

# Opcionais (segundos)
TIMEOUT_REQUISICAO=15
TIMEOUT_ASSINCRONO=20
ESPERA_ESTABILIZACAO=3

# Só se a URL de homologação não contiver a palavra "homolog":
# PERMITIR_URL_FORA_DE_HOMOLOG=1
# Liga o teste que gasta o limite diário (R$ 5.000) da conta A. Veja o docstring antes.
# RODAR_TESTES_LIMITE_DIARIO=1
