# Copie para .env e carregue no shell:  set -a; source .env; set +a
# Não versione o .env. Tokens e IDs de conta vêm de quem administra a homologação.

API_BASE_URL=https://api-homolog.bancodigital.exemplo/v1
API_TOKEN_A=            # Bearer token do usuário de teste A (titular da conta A)
API_TOKEN_B=            # Bearer token do usuário de teste B (titular da conta B)
CONTA_A_ID=             # UUID da conta de A
CONTA_B_ID=             # UUID da conta de B
CHAVE_PIX_B=            # chave PIX que aponta para a conta de B (destino das transferências A->B)

# Opcionais
CHAVE_PIX_A=            # chave PIX da conta de A: habilita B->A, devolução dos destrutivos e provas de ausência inversas
API_FUSO=America/Sao_Paulo   # fuso do "dia" do limite diário e dos filtros de data
API_ESPERA_MAX=20            # segundos de espera por efeitos assíncronos (PROCESSANDO)
RUN_TESTES_DESTRUTIVOS=      # 1 liga os testes que movem valores altos (rode por último)
API_PERMITIR_HOST_FORA_DE_HOMOLOG=   # 1 só se o host de teste não tiver "homolog" no nome
